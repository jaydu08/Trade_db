[Unit]
Description=Publish public-only Trend Agent market snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Trade_db
ExecStart=/usr/bin/python3 /root/Trade_db/scripts/publish_agent_snapshot.py --root /root/Trade_db --crypto-db /root/alpha_news/data/crypto_trend.sqlite --repo /root/trend_agent_public
TimeoutStartSec=180
Nice=10
UMask=0022
